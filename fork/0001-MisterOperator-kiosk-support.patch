diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
new file mode 100644
index 0000000..3cf534f
--- /dev/null
+++ b/.github/workflows/build.yml
@@ -0,0 +1,44 @@
+# Builds the MiSTer main binary with the official ARM GCC 10.2 toolchain, as
+# upstream Main_MiSTer does, and attaches it to the run (and to a release when
+# a tag like v1.0-kiosk is pushed).
+name: Build MiSTer
+
+on:
+  push:
+    branches: [master, kiosk]
+    tags: ["v*"]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+jobs:
+  build:
+    runs-on: ubuntu-22.04
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Cache ARM toolchain
+        uses: actions/cache@v4
+        with:
+          path: gcc-arm-10.2-2020.11-x86_64-arm-none-linux-gnueabihf
+          key: gcc-arm-10.2-2020.11
+
+      - name: Build
+        run: |
+          set -e
+          source setup_default_toolchain.sh
+          make -j"$(nproc)"
+          ls -l bin/MiSTer
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: MiSTer
+          path: bin/MiSTer
+
+      - name: Release
+        if: startsWith(github.ref, 'refs/tags/')
+        uses: softprops/action-gh-release@v2
+        with:
+          files: bin/MiSTer
