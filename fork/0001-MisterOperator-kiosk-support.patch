diff --git a/kiosk.cpp b/kiosk.cpp
new file mode 100644
index 0000000..685086d
--- /dev/null
+++ b/kiosk.cpp
@@ -0,0 +1,43 @@
+#include <stdio.h>
+#include <sys/stat.h>
+
+#include "kiosk.h"
+#include "hardware.h"
+#include "user_io.h"
+#include "spi.h"
+#include "support.h"
+
+bool kiosk_active()
+{
+	// Checked from the main loop, so look at the file at most every 200 ms.
+	static unsigned long next_check = 0;
+	static bool active = false;
+
+	if (!next_check || CheckTimer(next_check))
+	{
+		struct stat st;
+		active = !stat(KIOSK_FLAG, &st);
+		next_check = GetTimer(200);
+	}
+	return active;
+}
+
+void kiosk_write_features()
+{
+	FILE *f = fopen(KIOSK_FEATURES, "w");
+	if (f)
+	{
+		fputs("kiosk_active\nsave_nvram\nquiet_volume\n", f);
+		fclose(f);
+	}
+}
+
+void kiosk_save_nvram()
+{
+	// Same check the OSD makes before its "Saving..." screen.
+	if (is_arcade() && spi_uio_cmd(UIO_CHK_UPLOAD))
+	{
+		printf("kiosk: saving nvram\n");
+		arcade_nvm_save();
+	}
+}
diff --git a/kiosk.h b/kiosk.h
new file mode 100644
index 0000000..c847fb6
--- /dev/null
+++ b/kiosk.h
@@ -0,0 +1,26 @@
+#ifndef KIOSK_H
+#define KIOSK_H
+
+// MisterOperator kiosk support.
+//
+// The kiosk (https://github.com/alex-acsit/MisterOperator) creates KIOSK_FLAG
+// while it owns the screen. While it exists:
+//   - the menu core goes straight to the Linux framebuffer the kiosk draws on,
+//     instead of showing the MiSTer menu;
+//   - the OSD can't be opened and the OSD hotkeys are ignored;
+//   - volume changes don't pop up the OSD volume bar.
+// Without the file, everything behaves exactly like upstream Main_MiSTer.
+//
+// Extra MiSTer_cmd commands (always available):
+//   save_nvram   save the running arcade core's NVRAM without opening the OSD
+//
+// At start-up KIOSK_FEATURES lists what this build supports, one word per line.
+
+#define KIOSK_FLAG     "/tmp/kiosk_active"
+#define KIOSK_FEATURES "/tmp/MiSTer_features"
+
+bool kiosk_active();
+void kiosk_write_features();
+void kiosk_save_nvram();
+
+#endif
